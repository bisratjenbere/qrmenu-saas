{
  "name": "qr-menu",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "npm run db:migrate && npm run start --workspace=@qrmenu/api",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "npm -w packages/db run generate",
    "db:push": "npm -w packages/db run push",
    "db:migrate": "npm -w packages/db run migrate",
    "db:seed": "npm -w packages/db run seed",
    "db:studio": "npm -w packages/db run studio"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.2"
}
